# DNSWatch Environment Configuration — EXAMPLE FILE
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to GitHub!

# Flask Secret Key — change this to a random secure string
SECRET_KEY=your-secret-key-here-change-this

FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=dnswatch_db

# Default Network Capture Settings
DEFAULT_CAPTURE_INTERFACE=
CAPTURE_FILTER=udp port 53 or tcp port 53
BATCH_FLUSH_INTERVAL=1.0
BATCH_SIZE=25

# DNS Query Frequency Detection Defaults
DEFAULT_FREQUENCY_THRESHOLD=100
DEFAULT_FREQUENCY_WINDOW=60
