# DNSWatch Environment Configuration
SECRET_KEY=dnswatch-secret-key-ias2-2026-secure-session
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dnswatch_db

# Default Network Capture Settings
DEFAULT_CAPTURE_INTERFACE=
CAPTURE_FILTER=udp port 53 or tcp port 53
BATCH_FLUSH_INTERVAL=1.0
BATCH_SIZE=25

# DNS Query Frequency Detection Defaults
DEFAULT_FREQUENCY_THRESHOLD=100
DEFAULT_FREQUENCY_WINDOW=60
